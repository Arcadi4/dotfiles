// 将键绑定放在此文件中以覆盖默认值
[
    {
        "key": "ctrl+cmd+/",
        "command": "workbench.action.chat.open",
        "when": "chatPanelParticipantRegistered"
    },
    {
        "key": "ctrl+cmd+i",
        "command": "-workbench.action.chat.open",
        "when": "chatPanelParticipantRegistered"
    },
    {
        "key": "cmd+0",
        "command": "workbench.action.zoomReset"
    },
    {
        "key": "cmd+numpad0",
        "command": "-workbench.action.zoomReset"
    },
    {
        "key": "cmd+0",
        "command": "-workbench.action.focusSideBar"
    },
    {
        "key": "cmd+k cmd+s",
        "command": "workbench.action.files.saveAll"
    },
    {
        "key": "shift+cmd+,",
        "command": "extension.wrapTag",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+i",
        "command": "-extension.wrapTag",
        "when": "editorTextFocus"
    },
    {
        "key": "cmd+i",
        "command": "-geminicodeassist.showinEditor",
        "when": "authLoggedIn && config.geminicodeassist.enable && editorTextFocus && shouldRegisterInEditorCommand && !inGeminiDiffView && !isInDiffEditor"
    },
    {
        "key": "shift+cmd+,",
        "command": "extension.htmlTagWrap",
        "when": "editorTextFocus"
    },
    {
        "key": "alt+w",
        "command": "-extension.htmlTagWrap",
        "when": "editorTextFocus"
    }
]