[include]
	path = ~/.gitconfig.local
[oh-my-zsh]
	git-commit-alias = 74965c96098134b192f00084f966b4b02438a739
[alias]
	c = commit
	co = checkout
	rb = rebase
	br = branch
	s = status
	lo = log --oneline --graph --decorate
	pf = push --force-with-lease
	pl = pull --rebase --auto-stash
[gpg]
	program = gpg
	format = ssh
[commit]
	gpgsign = true
[tag]
	forceSignAnnotated = true
	gpgSign = true
[gpg "ssh"]
	program = ssh-keygen
	allowedSignersFile =
[core]
	# commit message 使用 nvim
	editor = "nvim"

[sequence]
	# rebase todo 使用 VSC
	# editor = "code --wait"
	editor = "nvim"

[user]
	email = 97033226+Arcadi4@users.noreply.github.com
	name = 4rcadia
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[rerere]
	enabled = false
[pull]
	rebase = true
	ff = false
	autostash = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[diff "schematic"]
  command = schematic-diff --pack Minecraft/vanilla.zip
[push]
	default = upstream
